#!/usr/bin/env bash
# スニペットを選んでアクティブなペインへ送り込む。
#
# 送り先は ssh 先やコンテナ内のシェルなど「zsh 以外」でもありうるため、
# scope は remote を使う。手元の zsh で使う場合は zsh 側の ^x^x を使う。
set -ueo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
SELECT="$DOTFILES_DIR/snippets/select"
SNIPPET_PANE_HEIGHT=20

# TMUX_PANE は run-shell 経由だと実際のアクティブペインと食い違うことがあるため使わない
PANE=$(tmux display-message -p '#{pane_id}')

# 選択用のペインを開き、結果を元のペインへ送ってから閉じる。
# send-keys -l はキー名解決を行わないため、バックスラッシュを含む
# スニペットもそのまま渡る。実行はせず、入力しただけの状態にする。
tmux split-window -l "$SNIPPET_PANE_HEIGHT" \
  "cmd=\$('$SELECT' remote) && tmux send-keys -t '$PANE' -l -- \"\$cmd\""
