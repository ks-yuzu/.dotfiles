#!/usr/bin/env bash
#
# tmux の window-status-format / window-status-current-format に埋めるラベルを組み立てる。
#
# 入力は .tmux.conf.common が渡す次の環境変数と $HOME。他には依存しない。
#   _TMUX_IS_CURRENT_PANE       true / false
#   _TMUX_WINDOW_NAME           #{window_name}
#   _TMUX_PANE_ID               #{pane_id}               例: %5
#   _TMUX_PANE_PID              #{pane_pid}
#   _TMUX_PANE_CURRENT_PATH     #{pane_current_path}
#   _TMUX_PANE_CURRENT_COMMAND  #{pane_current_command}
#
# 出力は tmux が再展開する。#[...] や #{...} をそのまま埋め込める。値が刻々と変わるもの
# (エージェントの状態) は解決せず format のまま渡す。#() の出力は status-interval まで
# キャッシュされるため、ここで解決すると再描画に追従できない。
#
# status-interval ごとに全ウィンドウ分が実行される。1 プロセスの起動コストが支配的なので、
# 外部コマンドの呼び出し回数を増やさないこと。特に perl は plenv の shim 経由で 1 秒近く
# かかるため使わない。

# ========== 設定 ==========

readonly SESSION_NAME_WIDTH=20        # 表示幅。全角は 2 桁として数える
readonly PATH_DEPTH_AGENT=3           # エージェントのウィンドウで出す path の要素数
readonly PATH_DEPTH_SHELL=1           # シェルのウィンドウで出す path の要素数

# Nerd Font の cod-claude / cod-openai。tmux は 1 桁として数えるが実際の描画は
# それより広いため、後続を潰さないよう空白を 1 つ足す。色を付ける場合は #[fg=...] で挟む
readonly ICON_CLAUDE=$' '
#readonly ICON_CLAUDE=$'#[fg=color174]\uec82#[fg=default] '
readonly ICON_CODEX=$' '

readonly CLAUDE_SESSIONS_DIR="$HOME/.claude/sessions"

# ========== ペインの状態 ==========

# 条件式で pgrep を直接呼ぶと、その出力がそのままラベルに混入する。必ず変数に取る
function find-ssh-processes {
  pgrep -flaP "$_TMUX_PANE_PID" ssh 2> /dev/null
}

function is-ssh-pane {
  [ -n "$SSH_PROCESSES" ]
}

# ペイン配下のプロセスを再帰的に列挙する。1 プロセスあたり ps と pgrep を起動するため
# 高価。エージェントの判定で他の手段が尽きた場合だけ使う
function pane-command-tree {
  local pids pid children child_pid

  pids=("$_TMUX_PANE_PID")
  while [ "${#pids[@]}" -gt 0 ]; do
    pid="${pids[0]}"
    pids=("${pids[@]:1}")

    ps -p "$pid" -o pid= -o args= 2> /dev/null

    children="$(pgrep -flaP "$pid" 2> /dev/null)"
    [ -z "$children" ] && continue

    echo "$children"
    while read -r child_pid _; do
      [ -n "$child_pid" ] && pids+=("$child_pid")
    done <<< "$children"
  done
}

# ========== claude のセッション ==========

# このペインで動いている claude の session ファイルを返す。claude 自身が tmux の
# ペインを記録しているため、プロセスツリーを走査せずに引ける。
# 終了したセッションのファイルは残るので、pid の生存で除く
function find-claude-session-file {
  local pid file

  while IFS=$'\t' read -r pid file; do
    kill -0 "$pid" 2> /dev/null || continue
    printf '%s' "$file"
    return
  done < <(jq -r --arg pane "$_TMUX_PANE_ID" '
    select($pane != "" and ((.tmux // "") | endswith(".\($pane)")))
    | [.pid, input_filename] | @tsv
  ' "$CLAUDE_SESSIONS_DIR"/*.json 2> /dev/null)
}

# 明示的に設定された名前を SESSION_NAME_WIDTH 桁に収めて返す。自動で付いた名前は
# nameSource で判別する。値ではなく除外側を列挙するのは、明示側の値が増えても
# 名前が消えないようにするため (claude 2.1.250 で user / hook / peer が追加された)。
# フィールド自体が無いのは 2.1.246 以前の明示名。
# 打ち切りも jq でやる。プロセスを増やさず、locale にも依存しない
function claude-session-name {
  [ -z "$CLAUDE_SESSION_FILE" ] && return

  jq -r --argjson limit "$SESSION_NAME_WIDTH" '
    def char_width: if . >= 32 and . <= 126 then 1 else 2 end;

    # 幅が収まらない場合は末尾を … に替える。… も 2 桁を占める
    def fit:
      explode
      | if (map(char_width) | add // 0) <= $limit then implode
        else
          reduce .[] as $c ({ chars: [], used: 0, done: false };
            if .done or .used + ($c | char_width) > $limit - 2 then .done = true
            else .chars += [$c] | .used += ($c | char_width)
            end)
          | (.chars | implode) + "…"
        end;

    def is_auto_name: . == "derived" or . == "auto" or . == "collision";

    select((.nameSource // "user") | is_auto_name | not)
    | .name // empty
    | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "")
    | select(. != "")
    | fit
  ' "$CLAUDE_SESSION_FILE" 2> /dev/null
}

# ========== エージェントの判定 ==========

# claude / codex / 空文字列 のいずれかを返す。安い順に試す
function detect-agent {
  local tree

  # ウィンドウ名は明示的な宣言として最優先で扱う
  case "$_TMUX_WINDOW_NAME" in
    claude | codex) echo -n "$_TMUX_WINDOW_NAME"; return ;;
  esac

  case "$_TMUX_PANE_CURRENT_COMMAND" in
    claude | codex) echo -n "$_TMUX_PANE_CURRENT_COMMAND"; return ;;
  esac

  # session ファイルがあれば claude が動いている。走査より安く、確実
  [ -n "$CLAUDE_SESSION_FILE" ] && { echo -n 'claude'; return; }

  tree="$(pane-command-tree)"
  if grep -Eiq '(^|[ /])claude([[:space:]]|$)' <<< "$tree"; then
    echo -n 'claude'
  elif grep -Eiq '(^|[ /])codex([[:space:]]|$)|@openai/codex' <<< "$tree"; then
    echo -n 'codex'
  fi
}

# ========== ラベルの部品 ==========

function emit-agent-icon {
  case "$1" in
    claude) printf '%s' "$ICON_CLAUDE" ;;
    codex)  printf '%s' "$ICON_CODEX" ;;
    *)      printf '%s' "$1" ;;
  esac
}

# $HOME なら HOME、それ以外は path の末尾 $1 要素を出す
function emit-path-label {
  local depth="$1" rest part label=''

  if [ "$_TMUX_PANE_CURRENT_PATH" = "$HOME" ]; then
    echo -n 'HOME'
    return
  fi

  rest="${_TMUX_PANE_CURRENT_PATH%/}"
  while [ "$depth" -gt 0 ] && [ -n "$rest" ] && [ "$rest" != '/' ]; do
    part="${rest##*/}"
    rest="${rest%/*}"
    label="$part${label:+/$label}"
    depth=$((depth - 1))
  done

  echo -n "$label"
}

function emit-repo-suffix {
  local toplevel

  toplevel="$(git -C "$_TMUX_PANE_CURRENT_PATH" rev-parse --show-toplevel 2> /dev/null)"
  [ -n "$toplevel" ] && echo -n " (${toplevel##*/})"
}

function emit-ssh-label {
  grep -Po '(?<=/usr/bin/)?ssh\s.*$' <<< "$SSH_PROCESSES" | tail -n 1 | tr -d '\n'
}

# 状態は claude の hook が @claude_state に書き、refresh-client -S で再描画させる。
# 値をここで解決すると #() のキャッシュに阻まれて追従できないため format のまま渡す
function emit-claude-state {
  echo -n '#{?#{==:#{@claude_state},busy},#[fg=yellow] ⏳#[fg=default] ,}'
  echo -n '#{?#{==:#{@claude_state},waiting},#[fg=red] 🔔#[fg=default] ,}'
  echo -n '#{?#{==:#{@claude_state},idle},#[fg=green] ✔#[fg=default] ,}'
}

function emit-current-pane-style {
  [ "$_TMUX_IS_CURRENT_PANE" = true ] || return

  if is-ssh-pane; then
    echo -n '#[fg=colour255,bg=#00aa22,bold]'
  else
    echo -n '#[fg=colour255,bg=#cc4400,bold]'
  fi
}

# ========== ラベルの組み立て ==========

# 明示名が無い場合の扱いは別途検討する。それまでは従来どおり path と repo 名を出す
function emit-location-label {
  echo -n ' ['
  emit-path-label "$PATH_DEPTH_AGENT"
  echo -n ']'
  emit-repo-suffix
}

function emit-agent-label {
  local agent="$1" session_name

  emit-agent-icon "$agent"

  # @claude_state は claude 専用。codex のウィンドウには前の claude の値が残りうる
  if [ "$agent" != 'claude' ]; then
    emit-location-label
    return
  fi

  # 明示名にはタスク ID と表題が入るため、path や repo 名より状況を特定できる
  session_name="$(claude-session-name)"
  if [ -n "$session_name" ]; then
    echo -n " $session_name"
  else
    emit-location-label
  fi

  emit-claude-state
}

function emit-window-label {
  local agent

  agent="$(detect-agent)"
  if [ -n "$agent" ]; then
    emit-agent-label "$agent"
    return
  fi

  case "$_TMUX_WINDOW_NAME" in
    zsh | reattach-to-user-namespace)
      emit-path-label "$PATH_DEPTH_SHELL"
      ;;
    *)
      if is-ssh-pane; then
        emit-ssh-label
      else
        echo -n '#W'
      fi
      ;;
  esac

  emit-repo-suffix
}

function window-status {
  emit-current-pane-style
  echo -n " #I: "
  emit-window-label
  echo -n ' '
}

# ========== 実行 ==========

# 同じ情報を複数の分岐で使う。関数内でキャッシュしてもコマンド置換のサブシェルを
# 跨げないため、ここで 1 度だけ集めて以降は参照するだけにする
SSH_PROCESSES="$(find-ssh-processes)"
CLAUDE_SESSION_FILE="$(find-claude-session-file)"

# 改行が混ざるとステータス行が崩れるため、まとめてから出す
echo -n "$(window-status)"
